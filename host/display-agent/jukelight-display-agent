#!/bin/sh
# Jukelight display agent: follows the backend's display decisions
# (GET /api/v1/display) and switches the monitor with swaymsg. Runs as a
# systemd user service in the kiosk's sway session; see
# docs/reference-setup.md.
#
# Settings (environment):
#   JUKELIGHT_URL     backend address             (default http://localhost:8080)
#   RETRY_SECONDS     wait between connections    (default 5)
#   SILENCE_SECONDS   reconnect after this long without data or heartbeat
#                     (default 60)
#   FAILSAFE_SECONDS  switch off after this long without the backend
#                     (default 600)
#   POWER_ON_COMMAND  run after switching the outputs on, for example to
#                     switch a smart plug (default: none)
#   POWER_OFF_COMMAND run after switching the outputs off (default: none)

set -u

url="${JUKELIGHT_URL:-http://localhost:8080}"
retry="${RETRY_SECONDS:-5}"
silence="${SILENCE_SECONDS:-60}"
failsafe="${FAILSAFE_SECONDS:-600}"
power_on_command="${POWER_ON_COMMAND:-}"
power_off_command="${POWER_OFF_COMMAND:-}"

# Unix seconds of the backend's last data (decision or heartbeat), for the
# fail-safe, and of the current connection's last data or start, for the
# silence limit. Files, because the watchdog runs in a background subshell
# and must see what follow writes in the main shell; a shell variable would
# not reach it.
work=$(mktemp -d)
contact="$work/contact"
seen="$work/seen"
stream="$work/stream"
mkfifo "$stream"
pids=""
command_pid=""
trap 'rm -rf "$work"' EXIT
# shellcheck disable=SC2086 # $pids holds two process ids
trap 'kill $pids $command_pid 2> /dev/null; exit 0' INT TERM

# Writes the time $2 (default: now) to file $1. Through a rename, so a
# concurrent reader never sees a truncated, empty file.
stamp() {
  echo "${2:-$(date +%s)}" > "$1.new" && mv "$1.new" "$1"
}

cr=$(printf '\r')

stamp "$contact"

# Switches failed in a row. After 3 the agent stops, so its service manager
# starts it again with the current environment: a stale sway socket (sway
# restarted after the agent) must not keep it failing unnoticed.
failures=0

# Runs the power command $2 for the switch $1 until it succeeds. The first
# wait is the retry interval, each further one twice the one before, up to
# 5 minutes: a plug locks itself after refused passwords, and frequent
# attempts would keep it locked. Logs the first failure and the recovery,
# not every attempt. Stopped, it also stops its command or sleep: both run
# in the background, so the stop takes effect at once.
retry_power_command() {
  child=""
  trap '[ -z "$child" ] || kill "$child" 2> /dev/null; exit 0' TERM
  failed=false
  pause=$retry
  while true; do
    # The command's own error message only once, with the first failure.
    if [ "$failed" = false ]; then
      sh -c "$2" > /dev/null &
    else
      sh -c "$2" > /dev/null 2>&1 &
    fi
    child=$!
    if wait "$child"; then
      child=""
      break
    fi
    child=""
    if [ "$failed" = false ]; then
      echo "power command for $1 failed; retrying, with waits from ${retry}s up to 5 min" >&2
      failed=true
    fi
    sleep "$pause" &
    child=$!
    wait "$child"
    child=""
    pause=$((pause * 2))
    if [ "$pause" -gt 300 ]; then
      pause=300
    fi
  done
  if [ "$failed" = true ]; then
    echo "power command for $1 succeeded after retrying" >&2
  fi
}

# Runs the configured power command for the switch $1 (on or off), if any,
# in the background, so a slow or unreachable plug never holds up the
# decisions. A newer switch first stops the older command, so an old "on"
# never lands after a newer "off". Its failures don't count as failed
# switches: restarting the agent doesn't help an unreachable plug.
power_command() {
  if [ -n "$command_pid" ]; then
    kill "$command_pid" 2> /dev/null
    wait "$command_pid" 2> /dev/null
    command_pid=""
  fi
  case $1 in
    on) command=$power_on_command ;;
    *) command=$power_off_command ;;
  esac
  [ -n "$command" ] || return 0
  retry_power_command "$1" "$command" &
  command_pid=$!
}

# Switches the outputs, then runs the power command.
power() {
  if swaymsg "output * power $1" > /dev/null; then
    echo "display $1"
    failures=0
  else
    failures=$((failures + 1))
    echo "swaymsg failed to switch the display $1 ($failures in a row)" >&2
    if [ "$failures" -ge 3 ]; then
      echo "stopping after $failures failed switches; sway may have restarted" >&2
      exit 1
    fi
  fi
  power_command "$1"
}

# Applies the first decision of a connection, then only changes. Blank
# lines only end an event; every other line (a decision or a heartbeat)
# counts as contact. $contact is read only by this shell, so it needs no
# rename.
follow() {
  applied=""
  while IFS= read -r line; do
    line=${line%"$cr"}
    [ -n "$line" ] || continue
    now=$(date +%s)
    echo "$now" > "$contact"
    stamp "$seen" "$now"
    case $line in
      data:*)
        decision=${line#data:}
        decision=${decision# }
        case $decision in
          on | off)
            if [ "$decision" != "$applied" ]; then
              power "$decision"
              applied=$decision
            fi
            ;;
        esac
        ;;
    esac
  done
}

# Ends the connection (process $1) after the silence limit without data.
# Sleeps until the limit could next be reached, not on a short interval,
# so the agent stays idle between messages; data that arrives meanwhile
# moves the limit, which the next round sees.
watchdog() {
  # Stopped with the connection, it also stops its sleep, so no long sleep
  # is left behind after each connection.
  nap=""
  trap '[ -z "$nap" ] || kill "$nap" 2> /dev/null; exit 0' TERM
  while true; do
    last=$(cat "$seen" 2> /dev/null)
    left=1
    if [ -n "$last" ]; then
      left=$(( last + silence - $(date +%s) ))
      if [ "$left" -le 0 ]; then
        kill "$1" 2> /dev/null
        return
      fi
    fi
    sleep "$left" &
    nap=$!
    wait "$nap"
    # Ended: its process id may be reused, so the trap must not kill it.
    nap=""
  done
}

off_by_failsafe=false
while true; do
  before=$(cat "$contact")
  started=$(date +%s)
  stamp "$seen"
  curl --silent --no-buffer --fail --connect-timeout "$retry" \
    "$url/api/v1/display" > "$stream" &
  curl_pid=$!
  watchdog "$curl_pid" &
  watchdog_pid=$!
  pids="$curl_pid $watchdog_pid"
  follow < "$stream"
  kill "$curl_pid" "$watchdog_pid" 2> /dev/null
  # Only these two: a power command may still be retrying.
  wait "$curl_pid" "$watchdog_pid" 2> /dev/null

  since=$(( $(date +%s) - $(cat "$contact") ))
  if [ "$since" -ge "$failsafe" ]; then
    if [ "$off_by_failsafe" = false ]; then
      echo "backend unreachable for ${since}s: switching the display off" >&2
      power off
      off_by_failsafe=true
    fi
  else
    off_by_failsafe=false
  fi

  # Reconnect at once after a connection that delivered data and lasted at
  # least the retry interval; otherwise wait, so a backend or proxy that
  # closes every connection at once is not hammered.
  if [ "$(cat "$contact")" = "$before" ] ||
    [ $(( $(date +%s) - started )) -lt "$retry" ]; then
    sleep "$retry"
  fi
done
