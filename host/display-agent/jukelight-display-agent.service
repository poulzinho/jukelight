# Jukelight display agent: switches the monitor with the music.
# Install for the kiosk user; see docs/reference-setup.md.
[Unit]
Description=Jukelight display agent
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/jukelight-display-agent
# JUKELIGHT_URL (where Jukelight runs) comes from the host's shared file;
# without it the agent uses http://localhost:8080. Other settings:
# systemctl --user edit jukelight-display-agent.
EnvironmentFile=-/etc/jukelight/host.env
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
