# Copy to .env and adjust. .env is git-ignored; never commit real values.

# Address of your BluOS player (IP or host name).
BLUOS_HOST=192.168.1.40
# BLUOS_PORT=11000

# Port the kiosk and API are served on.
HTTP_PORT=8080

# trace, debug, info, warn or error.
LOG_LEVEL=info

# Minutes the screen stays on after playback stops (0 to 1440).
# DISPLAY_GRACE_MINUTES=10

# Minutes an audio input (for example a CD player on the optical input)
# keeps the screen on after its signal started (0 to 1440). The player
# notices when a signal starts, not when it stops.
# INPUT_DISPLAY_MINUTES=90

# Brand logos (music services, Music Assistant, the player's maker, Hi-Res)
# are not part of Jukelight: put your own into ./brand-assets/ as
# <brand>.svg or <brand>.png (see docs/reference-setup.md). The container
# reads them from /brand-assets; change it only outside Docker:
# BRAND_ASSETS_DIR=/brand-assets

# Use a scripted fake player instead of a real one (development, demos):
# JUKELIGHT_DEVICE=fake:playing-with-queue

# Music Assistant (optional): shows what it plays on the player. Set both or
# neither. Create a long-lived token for a dedicated non-admin user.
# MA_URL=http://192.168.1.50:8095
# MA_TOKEN=your-long-lived-token
